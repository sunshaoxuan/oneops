{
  "name": "one-ops-portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @one-ops/portal-shell dev",
    "build": "pnpm --filter @one-ops/portal-shell build",
    "test": "node --test gateway/*.test.mjs && pnpm --filter @one-ops/portal-shell test",
    "check": "pnpm test && pnpm build",
    "test:operations": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-operations-scripts.ps1",
    "import:envportal": "node --env-file=.env.local scripts/import-envportal.mjs",
    "publish": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/publish-portal.ps1",
    "start:database": "docker compose --env-file .env.local up -d postgres",
    "start:gateway": "node --env-file=.env.local gateway/server.mjs"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "pg": "8.22.0"
  }
}
